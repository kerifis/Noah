{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/preview/talktv_simulator",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/index",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/preview/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
