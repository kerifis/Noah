<resources>
    <!-- Base Leanback / TV Theme -->
    <style name="Theme.TalkTV" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/tv_bg_dark</item>
        <item name="android:colorBackground">@color/tv_bg_dark</item>
        <item name="android:statusBarColor">@color/tv_bg_dark</item>
        <item name="android:navigationBarColor">@color/tv_bg_dark</item>
    </style>

    <style name="Theme.TalkTV.Fullscreen" parent="Theme.TalkTV">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
